{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "dependsOn": "build additional",
            "args": [
                "build",
                // Ask dotnet build to generate full paths for file names.
                "/property:GenerateFullPaths=true",
                // Do not generate summary otherwise it leads to duplicate errors in Problems panel
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        }, {
            "label": "build additional",
            "type": "shell",
            "command": "gcc -shared -fPIC C-Code/gtk4dotnet/gdn_aspect_container.c -o C-Code/gtk4dotnet/libtgtk4dotnet.so $(pkg-config --cflags --libs gtk4)"
        }, {
            "label": "build first.cpp",
            "type": "shell",
            "command": "g++ -g -O0 $(pkg-config --cflags gtk4) -o C-Code/first C-Code/first.cpp $(pkg-config --libs gtk4)"
        }, {
            "label": "build listview.cpp",
            "type": "shell",
            "command": "g++ -g -O0 $(pkg-config --cflags gtk4) -o C-Code/listview C-Code/listview.cpp $(pkg-config --libs gtk4)"
        }
    ]
}