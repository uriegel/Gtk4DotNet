{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Test",
            "type": "coreclr",
            "request": "launch",
            "requireExactSource": true, 
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Test/bin/Debug/net8.0/linux-x64/Test.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Test",
            "stopAtEntry": false,
            "justMyCode": false,
            "enableStepFiltering": true,
            "console": "integratedTerminal"
        }, {
            "name": "Test C",
            "type": "cppdbg",
            "request": "launch",
            // "preLaunchTask": "build",
            "program": "${workspaceFolder}/C/gobject",
            "args": [],
            "cwd": "${workspaceFolder}/C",
            "stopAtEntry": true,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [{
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }]            
        }, {
            "name": "Test C Custom Button",
            "type": "cppdbg",
            "request": "launch",
            // "preLaunchTask": "build",
            "program": "${workspaceFolder}/C/button",
            "args": [],
            "cwd": "${workspaceFolder}/C",
            "stopAtEntry": true,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [{
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }]            
        }
    ]
}