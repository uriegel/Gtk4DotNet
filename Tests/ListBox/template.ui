<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.2 -->
<interface>
  <!-- interface-name template.ui -->
  <requires lib="gtk" version="4.20"/>
  <object class="GtkWindow" id="window">
    <property name="default-height">800</property>
    <property name="default-width">600</property>
    <property name="title">"Hello ListBox👍"</property>
    <child>
      <object class="GtkBox">
        <property name="margin-bottom">20</property>
        <property name="margin-end">20</property>
        <property name="margin-start">20</property>
        <property name="margin-top">20</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkLabel">
            <property name="css-classes">
</property>
            <property name="label">Choose an Application to open &lt;b&gt;this file&lt;/b&gt;</property>
            <property name="margin-bottom">10</property>
            <property name="margin-end">20</property>
            <property name="margin-start">20</property>
            <property name="margin-top">0</property>
            <property name="use-markup">True</property>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="has-frame">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkListBox" id="listbox"/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
