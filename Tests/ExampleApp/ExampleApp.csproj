<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Gtk4DotNet/Gtk4DotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <GSchemaXml Include="Schema\*.gschema.xml" />
  </ItemGroup>

  <Target Name="CompileGSettingsSchemas" BeforeTargets="CoreCompile">

    <!-- Create a temporary schema directory in obj -->
    <MakeDir Directories="$(IntermediateOutputPath)gsettings" />

    <!-- Copy XML schemas -->
    <Copy SourceFiles="@(GSchemaXml)" DestinationFolder="$(IntermediateOutputPath)gsettings" />

    <!-- Generate gschemas.compiled -->
    <Exec Command="glib-compile-schemas &quot;$(IntermediateOutputPath)gsettings&quot;" />

  </Target>
  
  <ItemGroup>
    <EmbeddedResource Include="./window.ui">
      <LogicalName>window</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="./fileview.ui">
      <LogicalName>fileview</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="./preferences.ui">
      <LogicalName>preferences</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="./obj/$(Configuration)/net10.0/gsettings/gschemas.compiled">
      <LogicalName>gschemas</LogicalName>
    </EmbeddedResource> 
  </ItemGroup>

</Project>
