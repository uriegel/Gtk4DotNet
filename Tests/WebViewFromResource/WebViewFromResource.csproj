<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Gtk4DotNet/Gtk4DotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="webroot/index.html">
      <LogicalName>$([System.String]::new('%(RelativeDir)').SubString(8).Replace('\','/'))%(FileName)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="webroot/css/*.css">
      <LogicalName>$([System.String]::new('%(RelativeDir)').SubString(8).Replace('\','/'))%(FileName)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="webroot/images/image.jpg">
      <LogicalName>$([System.String]::new('%(RelativeDir)').SubString(8).Replace('\','/'))%(FileName)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup> 

</Project>
